# ==============================================================================
# Multi-Tenant Café QR Ordering SaaS Platform — Environment Configuration
# Copy this file to .env.local for local frontend development,
# and to backend/.env for local backend development.
# In production, configure these variables in your Vercel project settings.
# ==============================================================================

# ==============================================================================
# FRONTEND CONFIGURATION (Exposed to the browser via NEXT_PUBLIC_*)
# ==============================================================================

# Base URL of the backend API (e.g. http://localhost:8000/api or https://api.yourdomain.com/api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Ably client-side subscribe key or token endpoint configuration
# For client-side subscribing, use an Ably API Key with subscribe-only capabilities
NEXT_PUBLIC_ABLY_CLIENT_KEY=

# Public application base URL (e.g. http://localhost:3000 or https://yourdomain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base root domain used for multi-tenant subdomain resolution (e.g. yourdomain.com or localhost:3000)
NEXT_PUBLIC_DOMAIN=localhost:3000


# ==============================================================================
# BACKEND CONFIGURATION (Private & Secure — Never expose to browser)
# ==============================================================================

# MongoDB Atlas connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database name
MONGODB_DATABASE=cafe_qr_ordering

# JWT Secret for signing session tokens (use a 64+ char random hex or string)
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary Credentials (for product and café image storage & CDN)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Ably Real-time API Key (format: "appId.keyId:keySecret")
ABLY_API_KEY=your_ably_api_key

# Frontend URL for CORS and redirect resolution
FRONTEND_URL=http://localhost:3000

# Application root domain for multi-tenant cookie/subdomain validation
APP_DOMAIN=localhost

# Allowed CORS origins (JSON array or comma-separated list of origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
